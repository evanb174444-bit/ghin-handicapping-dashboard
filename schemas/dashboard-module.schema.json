{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dashboard-module.schema.json",
  "title": "Dashboard Module Contract",
  "type": "object",
  "required": ["schemaVersion", "module", "reportDate", "data", "metadata"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "reportDate": {
      "type": "string",
      "format": "date"
    },
    "completedThrough": {
      "type": ["string", "null"],
      "format": "date"
    },
    "data": {
      "type": "object"
    },
    "metadata": {
      "type": "object",
      "required": ["source", "generatedAt", "warnings"],
      "properties": {
        "source": {
          "type": "string"
        },
        "sourceHash": {
          "type": ["string", "null"]
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
